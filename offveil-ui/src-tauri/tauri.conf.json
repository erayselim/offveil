{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "offveil",
  "version": "1.0.0-b1",
  "identifier": "com.offveil.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "beforeBundleCommand": "npm run stage-bundle",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "offveil",
        "width": 420,
        "height": 520,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "center": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "skipTaskbar": true,
        "visible": false,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' asset: data: https://asset.localhost; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "nsis",
    "createUpdaterArtifacts": true,
    "publisher": "offveil",
    "homepage": "https://github.com/erayselim/offveil",
    "license": "Apache-2.0",
    "category": "Utility",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "bundle-bin/offveil-core.exe": "offveil-core.exe",
      "bundle-bin/sing-box.exe": "sing-box.exe",
      "bundle-bin/ciadpi.exe": "ciadpi.exe",
      "bundle-bin/wintun.dll": "wintun.dll",
      "bundle-bin/LICENSE": "LICENSE",
      "bundle-bin/THIRD_PARTY.md": "THIRD_PARTY.md",
      "bundle-bin/wintun-LICENSE.txt": "licenses/wintun-LICENSE.txt",
      "bundle-bin/byedpi-LICENSE.txt": "licenses/byedpi-LICENSE.txt",
      "bundle-bin/sing-box-LICENSE.txt": "licenses/sing-box-LICENSE.txt",
      "bundle-bin/sing-box-COPYING.txt": "licenses/sing-box-COPYING.txt"
    },
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "installerHooks": "./windows/hooks.nsh",
        "languages": ["English", "Turkish"],
        "displayLanguageSelector": true
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEM0QTFENkYwMEY3Q0JEOTEKUldTUnZYd1A4TmFoeEZIaXVwcjRNK2p1amI3TTJFMFlaTGdyNnF4Smttc2p0UWlhRDZCSlVqZjkK",
      "endpoints": [
        "https://github.com/erayselim/offveil/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
